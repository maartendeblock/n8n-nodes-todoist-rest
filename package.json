{
	"name": "n8n-nodes-todoist-rest",
	"version": "2.0.1-beta.1",
	"description": "Custom n8n node for the Todoist REST API with subtask and advanced workflow support",
	"author": {
		"name": "Maarten De Block",
		"email": "maarten@livalos.com"
	},
	"license": "MIT",
	"homepage": "https://github.com/maartendeblock/n8n-nodes-todoist-rest#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"todoist",
		"task-management"
	],
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/maartendeblock/n8n-nodes-todoist-rest.git"
	},
	"bugs": {
		"url": "https://github.com/maartendeblock/n8n-nodes-todoist-rest/issues"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes  --write",
		"lint": "eslint nodes  package.json",
		"lintfix": "eslint nodes  package.json --fix",
		"prepublishOnly": "pnpm build"
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@10.8.0",
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/TodoistApi.credentials.js",
			"dist/credentials/TodoistOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/TodoistCustomNode/TodoistCustomNode.node.js"
		]
	},
	"dependencies": {
		"uuid": "^14.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^9.39.4",
		"@types/node": "^25.9.1",
		"@types/uuid": "^11.0.0",
		"@typescript-eslint/parser": "^8.59.4",
		"eslint": "^10.4.1",
		"eslint-plugin-n8n-nodes-base": "^1.16.6",
		"globals": "^17.6.0",
		"gulp": "^5.0.1",
		"gulp-json-modify": "^1.0.2",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.8.3",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
